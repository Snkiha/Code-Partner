# Copy to .env and edit, or export these in your shell. CLI flags override them.
# ---------------------------------------------------------------------------

# Where Ollama is reachable. Inside Docker Compose this is set to the ollama
# service automatically.
OLLAMA_HOST=http://localhost:11434

# One model backs every role by default, so a first run only pulls one model.
CP_CODER_MODEL=qwen2.5-coder:7b

# Optional per-role overrides (fall back to CP_CODER_MODEL):
# CP_WRITER_MODEL=qwen2.5-coder:7b
# CP_REVIEWER_MODEL=qwen2.5-coder:7b
# CP_HEALER_MODEL=qwen2.5-coder:7b
# CP_CHAT_MODEL=qwen2.5-coder:3b        # a smaller model keeps chat snappy

# Download missing models automatically on startup instead of erroring.
CP_AUTO_PULL=0

# Project root the agent may read/write. Defaults to the directory you launch
# from. Generated code is confined to <root>/<CP_WORKSPACE>.
# CP_PROJECT_DIR=.
CP_WORKSPACE=workspace

# Self-heal loop tuning.
CP_MAX_HEAL_ROUNDS=3
CP_HEAL_WRITE_RETRIES=1

# --- run sandbox (bash_mcp_server) ---
# Per-command timeout in seconds for generated code.
BASH_MCP_TIMEOUT=20
# Extra executables the sandbox may invoke, comma separated.
# BASH_MCP_ALLOWED_EXTRA=sqlite3,jq
# Disable the allowlist entirely. Trusted / disposable environments only.
# BASH_MCP_ALLOW_ALL=0
